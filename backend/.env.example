# 本地开发配置。复制为 backend/.env 后再按需修改。
# 未配置密钥时，AI功能不可用；确定性推演不依赖外部模型。
APP_HOST=127.0.0.1
APP_PORT=8110

# DeepSeek OpenAI-compatible endpoint. The client appends /chat/completions.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 默认 deepseek-chat（与本项目 backend/.env 实际取值一致）；也可填 DeepSeek 开放平台提供的其他模型名。
LLM_MODEL=deepseek-chat
# 单次模型读取超时（秒，10–300）；任务总耗时可更长，前端会持续查询进度。
LLM_READ_TIMEOUT=120
# 所有 DeepSeek 环节默认 low；仍保留结构、财务和独立复盘审核。
LLM_REASONING_EFFORT=low
# 可按阶段覆盖（不需要改代码）：CASE_BASELINE / CASE_GENERATION / REVIEW_GENERATION / REVIEW_CHECK /
# TUTOR_PLAN / TUTOR_ANSWER / TEACHER_FIX。TIMEOUT 为单次请求总时限，不是读超时。
# LLM_CASE_GENERATION_MAX_TOKENS=12288
# LLM_CASE_GENERATION_TIMEOUT=180
# LLM_REVIEW_CHECK_REASONING_EFFORT=high
# 网页搜索可选，未配置密钥时仅用本地证据。
TAVILY_API_KEY=
TUTOR_SEARCH_DOMAINS=stats.gov.cn,pbc.gov.cn,worldbank.org,imf.org,oecd.org

# 可选供应商别名（优先使用上面的 LLM_* 配置）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# AI 制品目录；默认为 backend/data/artifacts，可迁移到对象存储适配器
# ARTIFACT_ROOT=

# 仅用于本机教师端登录；正式部署前请改成自己的口令。
TEACHER_PASSWORD=local-dev-only

# 留空时发布二维码自动使用当前浏览器访问后端的地址。
# 若要让同一局域网手机扫码，请填写本机局域网地址，例如：
# PUBLIC_BASE_URL=http://192.168.1.23:8100
PUBLIC_BASE_URL=

# 可选：自定义本地 SQLite 位置。默认 backend/data/app.db。
# DATABASE_URL=sqlite:///./backend/data/app.db
